{
  "name": "belentani-20-worlds",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "overrides": {
    "@babel/helper-string-parser": "7.27.1",
    "@babel/helper-validator-identifier": "7.27.1",
    "@babel/types": "7.28.4",
    "@typescript-eslint/tsconfig-utils": "8.43.0",
    "@typescript-eslint/types": "8.43.0",
    "nanoid": "3.3.11",
    "ws": "8.18.3"
  },
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "bun --watch server/index.ts",
    "build": "tsc -b && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -b --pretty false",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/bodoni-moda": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "^9.7.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "7.9.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.43.0",
    "vite": "7.3.5",
    "vitest": "3.2.4"
  }
}
